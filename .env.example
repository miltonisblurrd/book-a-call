# Google Calendar
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REFRESH_TOKEN=your_google_refresh_token
GOOGLE_CALENDAR_ID=you@yourdomain.com

# Email (Resend — get your API key at resend.com)
RESEND_API_KEY=your_resend_api_key
YOUR_EMAIL=you@yourdomain.com

# Booking config
NEXT_PUBLIC_BOOKING_DURATION_MINUTES=30
# Set to /book-a-call for Webflow Cloud, leave empty for local dev
NEXT_PUBLIC_BASE_PATH=/book-a-call
